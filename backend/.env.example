# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# Database Configuration
# ============================================
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# ============================================
# JWT Configuration
# ============================================
# Generate a secure 256-bit secret:
# Linux/Mac/Git Bash: openssl rand -base64 32
# Windows PowerShell: See README.md for command
JWT_SECRET=your_256bit_jwt_secret_here

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
EMAIL_USERNAME=your-email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# To get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords
# 4. Generate password for "Mail"
# 5. Use the 16-character password here

# ============================================
# reCAPTCHA Configuration
# ============================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# To get reCAPTCHA keys:
# 1. Go to https://www.google.com/recaptcha/admin
# 2. Register a new site (v2 Checkbox)
# 3. Add domain: localhost (for development)
# 4. Copy Secret Key for backend
# 5. Copy Site Key for frontend (update index.html)

# ============================================
# Development vs Production
# ============================================
# For development: Use simple values for testing
# For production: Generate strong, unique secrets
# NEVER use the same secrets across environments!
